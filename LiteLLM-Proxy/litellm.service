[Unit]
Description=LiteLLM Proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pete/litellm
EnvironmentFile=/home/pete/litellm/.env
ExecStart=/opt/venv/bin/litellm --config /home/pete/litellm/config.yaml --port 4000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
